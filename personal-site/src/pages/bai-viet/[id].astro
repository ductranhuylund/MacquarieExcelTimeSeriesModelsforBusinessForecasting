---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths(){ return (await getCollection('posts')).map(post=>({params:{id:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — CT`} description={post.data.description} active="posts">
  <header class="page-heading"><p class="eyebrow">GHI CHÉP / {post.data.category}</p><h1>{post.data.title}</h1><p>{post.data.description}</p></header>
  <div class="article-layout">
    <aside class="article-sidebar"><p>CT<br/>{post.data.date.toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh'})}</p><p>Khoảng {post.data.readingMinutes} phút đọc</p><a href="/bai-viet/">← Các ghi chép</a></aside>
    <article class="article-body">{post.data.sample && <div class="article-notice">BÀI MẪU · Nội dung minh họa để duyệt website, chưa phải công bố hay báo cáo kết quả nghiên cứu của CT.</div>}<Content /><div class="prose-bottom"><a href="/bai-viet/">← Trở về các ghi chép</a></div></article>
  </div>
</Base>
