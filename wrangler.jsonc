{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ct26journal",
  "compatibility_date": "2026-10-27",
  "build": {
    "command": "npm ci --prefix personal-site && npm run build --prefix personal-site"
  },
  "assets": {
    "directory": "./personal-site/dist",
    "not_found_handling": "404-page"
  }
}
